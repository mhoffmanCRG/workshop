# ---Setup spindle at speed signals---

#sets spindle-at-speed true

loadrt scale names=scale.spindle,scale.feed,scale.rapid,scale.spindleOver,scale.jog
loadrt near
loadrt limit3 names=limit.spindle,limit.spindle_cmd

addf near.0                   servo-thread
addf scale.spindle            servo-thread
addf limit.spindle            servo-thread
addf limit.spindle_cmd        servo-thread


setp    limit.spindle.min       0
setp    limit.spindle.max       5000
#setp   limit.spindle.maxv      100

setp    limit.spindle_cmd.min   0
setp    limit.spindle_cmd.max   5000
setp    limit.spindle_cmd.maxv  400

net spindle-vel-cmd-rpm-abs => limit.spindle_cmd.in
net spindle_cmd_limit limit.spindle_cmd.out   => pid.s.command
net spindle-fb-rpm-filtered-abs =>  pid.s.feedback
net spindle-output         <=   pid.s.output

net spindle-vel-cmd-rpm    =>  near.0.in1
net spindle-fb-rpm-filtered     =>  near.0.in2
net spindle-at-speed       <=  near.0.out
setp near.0.scale 1.01
setp near.0.difference 10


setp   hm2_5i25.0.7i76.0.0.spinout-minlim    [SPINDLE_9]OUTPUT_MIN_LIMIT
setp   hm2_5i25.0.7i76.0.0.spinout-maxlim    [SPINDLE_9]OUTPUT_MAX_LIMIT
setp   hm2_5i25.0.7i76.0.0.spinout-scalemax  [SPINDLE_9]OUTPUT_SCALE

net spindle-output      => abs.spindle2.in
net spindle-output-abs abs.spindle2.out

net spindle-output  => limit.spindle.in

net spindle-output-limit limit.spindle.out  => hm2_5i25.0.7i76.0.0.spinout

net spindle-enable      => hm2_5i25.0.7i76.0.0.spinena
net spindle-ccw         => hm2_5i25.0.7i76.0.0.spindir

setp    hm2_5i25.0.encoder.00.counter-mode 0
setp    hm2_5i25.0.encoder.00.filter 1
setp    hm2_5i25.0.encoder.00.index-invert 0
setp    hm2_5i25.0.encoder.00.index-mask 0
setp    hm2_5i25.0.encoder.00.index-mask-invert 0
setp    hm2_5i25.0.encoder.00.scale  [SPINDLE_9]ENCODER_SCALE

net spindle-revs             <=   hm2_5i25.0.encoder.00.position
net spindle-vel-fb-rps       <=   hm2_5i25.0.encoder.00.velocity
net spindle-index-enable     <=>  hm2_5i25.0.encoder.00.index-enable



## ---Setup spindle at speed signals---
#
##sets spindle-at-speed true
#
net spindle-vel-cmd-rpm    =>  near.0.in1
net spindle-fb-rpm-filtered     =>  near.0.in2
net spindle-at-speed       <=  near.0.out
setp near.0.scale 1.01
setp near.0.difference 10
#
## ---Spindle synchronized motion
#
##  Use ACTUAL spindle velocity from spindle encoder
##  spindle-velocity bounces around so we filter it with lowpass
##  spindle-velocity is signed so we use absolute component to remove sign
##  ACTUAL velocity is in RPS not RPM so we scale it.
#
setp     scale.spindle.gain 60
setp     lowpass.spindle.gain 0.001
net spindle-vel-fb-rps        =>     scale.spindle.in
net spindle-fb-rpm               scale.spindle.out       =>   lowpass.spindle.in
net spindle-fb-rpm-filtered      lowpass.spindle.out         => abs.spindle.in
net spindle-fb-rpm-filtered-abs  abs.spindle.out




