# Include your custom_postgui HAL commands here
# This file will not be overwritten when you run PNCconf again
net remote-o100 halui.mdi-command-00 <= pyvcp.o100
net remote-o101 halui.mdi-command-01 <= pyvcp.o101
net remote-o102 halui.mdi-command-02 <= pyvcp.o102
net remote-o103 halui.mdi-command-03 <= pyvcp.o103
#net remote-o104 halui.mdi-command-04 <= pyvcp.o104
net remote-o105 halui.mdi-command-05 <= pyvcp.o105
net remote-o106 halui.mdi-command-06 <= pyvcp.o106

net remote-o107 halui.mdi-command-07 <= matrix_kb.0.key.r3c0
net remote-o109 halui.mdi-command-09 <= matrix_kb.0.key.r2c1
net remote-o110 halui.mdi-command-10 <= matrix_kb.0.key.r2c3

net  spindle-fb-rpm-filtered-abs        => pyvcp.spindle_rpm 
net  spindle-vel-cmd-rpm-abs        => pyvcp.spindle_speed
net  spindle-output        => pyvcp.spindle_out
net  spindle-at-speed       => pyvcp.motor_at_speed
net  spindle_cmd_limit       => pyvcp.spindle_cmd_limit
net  spindle-at-speed      => pyvcp.G90



# -- NC-script on set G54 after homed--
net y-is-homed => debounce.0.10.in
net mdi-cmd-startup <= debounce.0.10.out => halui.mdi-command-11

